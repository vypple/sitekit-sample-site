---
import Base from "../../layouts/Base.astro";
const posts = Object.values(import.meta.glob("./*.md", { eager: true })) as { frontmatter: { title: string; date: string }; url: string }[];
posts.sort((a, b) => b.frontmatter.date.localeCompare(a.frontmatter.date));
---
<Base title="Blog">
	<h1>From the bakery</h1>
	<ul>
		{posts.map((p) => <li><a href={p.url}>{p.frontmatter.title}</a> <small>{p.frontmatter.date}</small></li>)}
	</ul>
</Base>
