---
// The contact form posts to the bakery's order inbox. Locked in the Vypple editor.
---
<form action="https://example.com/harbor-lane-orders" method="post">
	<label>Name <input name="name" required /></label><br />
	<label>Email <input name="email" type="email" required /></label><br />
	<label>Message <textarea name="message" rows="4"></textarea></label><br />
	<button class="button" type="submit">Send</button>
</form>
